# Shared by /db (goose), /ingestion, /ml (python-dotenv, loaded from the
# current working directory — run those tools from the repo root, or copy
# this to a .env inside each directory), and /api (plain os.Getenv, no
# dotenv loading — export it or pass it inline when running the Go server).
#
# Local Postgres via Homebrew (`brew install postgresql@15`), db created with
# `createdb fantasyfootball`. Swap for a Supabase connection string later —
# nothing else in the codebase needs to change.
DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/fantasyfootball?sslmode=disable
CURRENT_SEASON=2026-27
